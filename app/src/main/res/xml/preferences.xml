<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Подключение">
        <EditTextPreference
            android:key="wled_ip"
            android:title="IP адрес ESP32"
            android:summary="Пример: 192.168.1.110"
            android:defaultValue="192.168.1.110" />

        <EditTextPreference
            android:key="udp_port"
            android:title="UDP Порт"
            android:summary="Обычно 21324 или 4048"
            android:defaultValue="4048"
            android:inputType="number" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Настройка изображения">

        <!-- ПРОСТОЙ ВВОД ЧИСЛА ВМЕСТО ПРОБЛЕМНОГО ПОЛЗУНКА -->
        <EditTextPreference
            android:key="buffer_size_sec"
            android:title="Размер буфера 4K (секунд)"
            android:summary="Рекомендуется от 50 до 120"
            android:defaultValue="50"
            android:inputType="number" />

        <EditTextPreference
            android:key="brightness"
            android:title="Яркость (0-100)"
            android:defaultValue="100"
            android:inputType="number" />

        <EditTextPreference
            android:key="gamma"
            android:title="Гамма (10-30)"
            android:summary="Контрастность"
            android:defaultValue="22"
            android:inputType="number" />

        <EditTextPreference
            android:key="fps"
            android:title="Ограничение FPS"
            android:defaultValue="30"
            android:inputType="number" />

        <EditTextPreference
            android:key="smoothing"
            android:title="Плавность (0-100)"
            android:defaultValue="50"
            android:inputType="number" />

        <EditTextPreference
            android:key="black_threshold"
            android:title="Порог черного (0-255)"
            android:summary="Для фильтрации темных сцен"
            android:defaultValue="15"
            android:inputType="number" />

        <SwitchPreferenceCompat
            android:key="use_v2"
            android:title="Использовать протокол V2"
            android:defaultValue="true" />
    </PreferenceCategory>

    <SwitchPreferenceCompat
        android:key="ambilight_enabled"
        android:title="Подсветка WLED"
        android:summary="Полностью включает/выключает синхронизацию с лентой"
        android:defaultValue="true" />

    <ListPreference
        android:key="capture_mode"
        android:title="Режим захвата кадра"
        android:summary="%s"
        android:entries="@array/capture_mode_entries"
        android:entryValues="@array/capture_mode_values"
        android:defaultValue="auto" />

    <PreferenceCategory android:title="Движок подсветки">
        <ListPreference
            android:key="ambilight_engine"
            android:title="Движок подсветки"
            android:summary="%s"
            android:entries="@array/engine_entries"
            android:entryValues="@array/engine_values"
            android:defaultValue="classic" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Новый движок (v2)">
        <EditTextPreference
            android:key="v2_smoothing"
            android:title="Плавность v2 (0-100)"
            android:summary="Работает только в новом движке"
            android:defaultValue="50"
            android:inputType="number" />

        <EditTextPreference
            android:key="v2_saturation"
            android:title="Насыщенность v2 (%)"
            android:summary="100 = как на экране, больше = ярче цвета"
            android:defaultValue="115"
            android:inputType="number" />

        <EditTextPreference
            android:key="v2_black_threshold"
            android:title="Порог чёрного v2 (0-255)"
            android:summary="Зоны темнее этого значения гасятся"
            android:defaultValue="15"
            android:inputType="number" />

        <SwitchPreferenceCompat
            android:key="v2_detect_bars"
            android:title="Определять чёрные полосы"
            android:summary="Для фильмов 21:9 с полосами, вшитыми в видео"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Тестовый движок (Lab)">
        <EditTextPreference
            android:key="lab_vivid"
            android:title="Яркость цвета Lab (0-100)"
            android:summary="0 = как на экране, 100 = очень сочно. Оттенок не уезжает"
            android:defaultValue="50"
            android:inputType="number" />

        <EditTextPreference
            android:key="lab_speed"
            android:title="Скорость реакции Lab (0-100)"
            android:summary="Больше = быстрее следует за картинкой, меньше = плавнее"
            android:defaultValue="50"
            android:inputType="number" />

        <EditTextPreference
            android:key="lab_edge"
            android:title="Вес к краю Lab (0-100)"
            android:summary="Больше = лента берёт цвет в основном у самого края кадра"
            android:defaultValue="50"
            android:inputType="number" />

        <EditTextPreference
            android:key="lab_depth"
            android:title="Глубина захвата Lab (5-50 %)"
            android:summary="Как далеко от края вглубь кадра учитывается цвет"
            android:defaultValue="22"
            android:inputType="number" />

        <ListPreference
            android:key="lab_highlight"
            android:title="Яркие блики Lab"
            android:summary="%s"
            android:entries="@array/lab_highlight_entries"
            android:entryValues="@array/lab_highlight_values"
            android:defaultValue="soft" />

        <ListPreference
            android:key="lab_glow"
            android:title="Фоновый свет в темноте Lab"
            android:summary="%s"
            android:entries="@array/lab_glow_entries"
            android:entryValues="@array/lab_glow_values"
            android:defaultValue="mid" />

        <ListPreference
            android:key="lab_jitter"
            android:title="Защита от дрожи Lab"
            android:summary="%s"
            android:entries="@array/lab_jitter_entries"
            android:entryValues="@array/lab_jitter_values"
            android:defaultValue="mid" />

        <ListPreference
            android:key="lab_fps"
            android:title="Частота вывода Lab"
            android:summary="%s"
            android:entries="@array/lab_fps_entries"
            android:entryValues="@array/lab_fps_values"
            android:defaultValue="60" />

        <SwitchPreferenceCompat
            android:key="lab_detect_bars"
            android:title="Определять чёрные полосы Lab"
            android:summary="Для фильмов 21:9 с полосами, вшитыми в видео"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Зоны захвата">
        <EditTextPreference
            android:key="margin_x"
            android:title="Отступ слева/справа (%)"
            android:defaultValue="2"
            android:inputType="number" />

        <EditTextPreference
            android:key="margin_y"
            android:title="Отступ сверху/снизу (%)"
            android:defaultValue="2"
            android:inputType="number" />

        <EditTextPreference
            android:key="capture_depth"
            android:title="Глубина захвата (%)"
            android:defaultValue="5"
            android:inputType="number" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Геометрия">
        <EditTextPreference
            android:key="leds_top"
            android:title="Светодиодов сверху"
            android:defaultValue="15"
            android:inputType="number" />

        <EditTextPreference
            android:key="leds_bottom"
            android:title="Светодиодов снизу"
            android:defaultValue="15"
            android:inputType="number" />

        <EditTextPreference
            android:key="leds_left"
            android:title="Светодиодов слева"
            android:defaultValue="10"
            android:inputType="number" />

        <EditTextPreference
            android:key="leds_right"
            android:title="Светодиодов справа"
            android:defaultValue="10"
            android:inputType="number" />

        <ListPreference
            android:key="direction"
            android:title="Направление"
            android:entries="@array/direction_entries"
            android:entryValues="@array/direction_values"
            android:defaultValue="0" />

        <EditTextPreference
            android:key="led_offset"
            android:title="Смещение (Offset)"
            android:defaultValue="0"
            android:inputType="number" />
    </PreferenceCategory>

</PreferenceScreen>